{
  "name": "bansos-router",
  "version": "0.1.7",
  "description": "Bansos for your AI agents — free, keyless coding models routed to every coding harness through one local endpoint. No accounts, no keys, no cost.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bansos": "dist/cli/index.js",
    "bansosd": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ui && esbuild src/cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli/index.js",
    "build:ui": "vite build",
    "dev": "tsx src/cli/index.ts",
    "dev:daemon": "tsx src/cli/index.ts daemon",
    "dev:ui": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "llm",
    "proxy",
    "router",
    "free-models",
    "coding-agent",
    "openai-compatible",
    "claude-code",
    "opencode",
    "pi",
    "codex"
  ],
  "dependencies": {
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "lucide-preact": "^1.33.0",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
