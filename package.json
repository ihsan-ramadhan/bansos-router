{
  "name": "bansos-router",
  "version": "0.5.1",
  "description": "Bansos for your AI agents. Free, keyless coding models routed to every coding harness through one local endpoint. No accounts, no keys, no cost.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "bansos": "dist/cli/index.js",
    "bansosd": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:ui && bun run build:cli",
    "build:ui": "bun --bun vite build",
    "build:cli": "bun scripts/build-cli.ts",
    "sync-version": "bun scripts/sync-version.mjs",
    "dev": "bun src/cli/index.ts",
    "dev:daemon": "bun src/cli/index.ts daemon",
    "dev:ui": "bun --bun vite",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test --isolate --timeout=30000",
    "prepare": "bun run build"
  },
  "keywords": [
    "llm",
    "proxy",
    "router",
    "free-models",
    "coding-agent",
    "openai-compatible",
    "claude-code",
    "opencode",
    "pi",
    "codex"
  ],
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.2.0",
    "lucide-preact": "^1.33.0",
    "preact": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
